---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Web-slinger Adventures">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
    <h1>Web-slinger Adventures</h1>
  </header>
  <canvas id="game"></canvas>
  <div id="touch-controls">
    <div id="joystick-ring"></div>
    <div id="joystick-knob"></div>
    <div id="jump-button"></div>
  </div>
  <div id="win-screen">
    <button id="win-restart" type="button">Restart</button>
    <button id="win-harder" type="button">Increase difficulty</button>
  </div>
  <script src="../scripts/main.ts"></script>
</Layout>
